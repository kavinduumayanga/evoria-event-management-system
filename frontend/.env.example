# For local Expo Go testing on physical devices (e.g., iPhone), use your machine's local IP address
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:5003/api

# For production on Azure Static Web Apps, point this to your Azure App Service backend URL
EXPO_PUBLIC_API_BASE_URL=https://YOUR_BACKEND_APP.azurewebsites.net/api
